generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Word {
  id         Int    @id @default(autoincrement())
  value      String @unique
  categories Json   @default("[]")

  @@map("words")
}

model Profile {
  id          Int        @id @default(autoincrement())
  authId      String     @unique @map("auth_id")
  username    String     @unique
  staffRole   StaffRole? @map("staff_role")
  records     Record[]
  coins       Int        @default(0)
  taughtWords Int        @default(0) @map("taught_words")

  @@map("profiles")
}

enum StaffRole {
  ADMIN
  TRUSTED
  DICTIONARY_MANAGER
}

model Record {
  id        Int      @id @default(autoincrement())
  key       String
  value     Int      @default(0)
  mode      String
  Profile   Profile? @relation(fields: [profileId], references: [id])
  profileId Int?     @map("profile_id")

  @@map("records")
}

model ActiveRoom {
  id          Int     @id @default(autoincrement())
  ownerAuthId String? @unique @map("owner_auth_id")
  code        String  @unique
  isDefault   Boolean @map("is_default")

  @@map("active_rooms")
}
