generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Word {
  id         Int     @id @default(autoincrement())
  value      String  @unique
  categories Json    @default("[]")
  isTested   Boolean @default(true) @map("is_tested")

  @@map("words")
}

model Profile {
  id          Int        @id @default(autoincrement())
  authId      String     @unique @map("auth_id")
  nickname    String     @unique
  roles       Json       @default("[]")
  records     Record[]
  taughtWords Int        @default(0) @map("taught_words")
  coins       Int        @default(0)
  playtime    Int        @default(0)
  items       ShopItem[]

  @@map("profiles")
}

model Blacklist {
  id     Int    @id @default(autoincrement())
  authId String @unique @map("auth_id")
  reason String

  @@map("blacklist")
}

model Record {
  id        Int      @id @default(autoincrement())
  key       String
  value     Int
  mode      String   @default("normal")
  Profile   Profile? @relation(fields: [profileId], references: [id])
  profileId Int?     @map("profile_id")

  @@map("records")
}

model ActiveRoom {
  id          Int     @id @default(autoincrement())
  ownerAuthId String? @map("owner_auth_id")
  code        String  @unique
  isDefault   Boolean @default(false) @map("is_default")

  @@map("active_rooms")
}

model ShopItem {
  id        Int      @id @default(autoincrement())
  itemId    Int      @map("item_id")
  value     String?  @db.Text
  Profile   Profile? @relation(fields: [profileId], references: [id])
  profileId Int?     @map("profile_id")

  @@map("shop_items")
}
